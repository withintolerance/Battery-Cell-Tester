# Copy to .env on the machine that runs the hub (not committed).

# Optional — Home Assistant webhook for “cells ready to swap” Alexa announce:
# HOME_ASSISTANT_SWAP_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/battery-tester-swap

# Optional dedicated out-of-range webhook. If omitted, range alerts use the
# swap webhook above. Events fire once per threshold crossing for:
#   - cell temp outside 15-38C (present cells)
#   - heatsink temp outside 15-50C
#   - cell voltage outside the chemistry window (+/- 150 mV slack)
#   - invalid cell temperature sensor on a present cell
# Alerts rearm after the reading recovers (temps use 3C hysteresis).
# HOME_ASSISTANT_THERMAL_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/battery-tester-thermal

# Optional overrides:
# PORT=3001
# HUB_DB_PATH=./data.db
# HUB_CONFIG_PATH=./config.json
